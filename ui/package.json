{
  "name": "strands-compose-chat-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:backend": "tsc -b && cross-env VITE_OUT_DIR=../src/strands_compose_chat/static vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:demo": "npm run build:demo && playwright test -c playwright.demo.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "^3.14.24",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "hast-util-to-html": "^9.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
