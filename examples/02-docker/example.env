# =============================================================================
# strands-compose-chat — Docker Compose configuration. Copy to ".env" here.
# DATABASE_URL comes from docker-compose.yaml and is NOT set in this file.
# =============================================================================

# --- MANDATORY ---------------------------------------------------------------

# Session cookie signing key, at least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# First-run admin account. Both are required, or no admin is created.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# --- COMMON ------------------------------------------------------------------

# dev | test | prod. See "GOING TO PRODUCTION" below before switching to prod.
APP_ENV=dev

# CUSTOM_HEADER_TITLE=My Chat

# Self-service registration. Defaults to true unless an OIDC provider is set.
# AUTH_REGISTRATION_ENABLED=false

# Require SSO. Needs an OIDC provider, and locks out the local bootstrap admin.
# AUTH_LOCAL_SIGNIN_ENABLED=false

# Pages allowed to embed the app in an iframe: ["self"] (default) or [] to deny.
# Sign-in cannot happen inside the frame — the OIDC provider refuses to be framed.
# FRAME_ANCESTORS=[]

# --- GOING TO PRODUCTION -----------------------------------------------------
# APP_ENV=prod rejects SQLite and wildcard ("*") hosts/origins, and makes the
# session cookie HTTPS-only — over plain HTTP sign-in then fails silently.
# Set both to your real domain:

# TRUSTED_HOSTS=["chat.example.com"]
# CORS_ALLOWED_ORIGINS=["https://chat.example.com"]

# --- OPTIONAL — OIDC single sign-on ------------------------------------------
# List the provider ids; each reads its own OIDC_<ID>_* variables.

# OIDC_PROVIDERS=["entra"]
# OIDC_REDIRECT_URI=https://chat.example.com/auth/callback
# OIDC_ENTRA_DISPLAY_NAME=Microsoft Entra
# OIDC_ENTRA_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# OIDC_ENTRA_CLIENT_ID=<client-id>
# OIDC_ENTRA_CLIENT_SECRET=<client-secret>
