# =============================================================================
# strands-compose-chat — local development configuration. Copy to ".env".
# =============================================================================

# --- MANDATORY ---------------------------------------------------------------

# Session cookie signing key, at least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# --- COMMON ------------------------------------------------------------------

# dev | test | prod. Keep "dev" to allow SQLite and cookies over plain http.
APP_ENV=dev

# First-run admin account. Both are required, or no admin is created.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=changeme  # pragma: allowlist secret

# Defaults to SQLite (./strands-chat.sqlite). Run `scc migrate` after changing it.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname  # pragma: allowlist secret

# CUSTOM_HEADER_TITLE=My Chat

# --- OPTIONAL — OIDC single sign-on ------------------------------------------
# List the provider ids; each reads its own OIDC_<ID>_* variables.

# OIDC_PROVIDERS=["entra"]
# OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# OIDC_ENTRA_DISPLAY_NAME=Microsoft Entra
# OIDC_ENTRA_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# OIDC_ENTRA_CLIENT_ID=<client-id>
# OIDC_ENTRA_CLIENT_SECRET=<client-secret>
